{
  "name": "{{projectName}}",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "neexp dev --all",
    "build": "neexp build --all",
    "lint": "neexp lint --all",
    "test": "neexp test --all",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "graph": "neexp --graph",
    "list": "neexp --list",
    "info": "neexp --info"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.9.2"
  }
}
